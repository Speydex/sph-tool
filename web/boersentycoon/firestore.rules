// ============================================================
// Firestore-Security-Rules für den BörsenTycoon Cloud-Speicherstand
// ============================================================
// Diese Datei wird NICHT automatisch deployt (dieses Projekt hat keine
// Firebase-CLI-Anbindung) — kopiere ihren Inhalt manuell in die Firebase-
// Konsole: Firestore Database -> Regeln -> einfügen (ersetzt den
// vorhandenen Text) -> Veröffentlichen.
//
// Wirkung:
// - saves/{userId}: Jede*r eingeloggte Nutzer*in darf ausschließlich das
//   eigene Speicherstand-Dokument lesen und schreiben. Niemand kann fremde
//   Spielstände sehen oder verändern, auch nicht über die Konsole/API.
// - leaderboard/{userId}: Öffentlich lesbar (auch ohne Login, damit die
//   Bestenliste im Spiel für alle sichtbar ist), aber jede*r darf
//   ausschließlich den eigenen Eintrag schreiben — niemand kann sich für
//   jemand anderen ausgeben oder fremde Platzierungen verändern.
// - players/{userId}: Eine kleine Registrierung "wer hat sich schon mal
//   eingeloggt" (E-Mail + letzter Login), damit der Admin im Spiel eine
//   Person zum Geld-Verschicken auswählen kann. Nur der Account selbst
//   und die fest hinterlegte Admin-E-Mail dürfen das lesen — die E-Mails
//   bleiben vor den anderen Mitspieler:innen privat.
// - gifts/{giftId}: Geld-Geschenke vom Admin an eine bestimmte Person
//   (per UID adressiert). Nur die Admin-E-Mail darf neue Geschenke
//   anlegen; die beschenkte Person darf ihr eigenes Geschenk lesen und
//   nach Erhalt löschen (damit es nicht doppelt gutgeschrieben wird).
//   Ersetze die E-Mail-Adresse unten an allen drei Stellen, falls sich
//   dein Admin-Account mal ändert.
//
// Schach (web/schach/, Online-Modus):
// - chessProfiles/{userId}: Spielername + Freundescode. Für alle
//   eingeloggten Nutzer:innen lesbar (damit man Freunde per Code findet),
//   schreiben darf nur der Account selbst.
// - chessFriends/{a_b}: Freundschaft zwischen zwei Accounts. Nur die beiden
//   Beteiligten können sie sehen. Anlegen darf man nur eine eigene Anfrage,
//   annehmen darf nur die angefragte Person, entfernen dürfen beide.
// - chessGames/{gameId}: Online-Partien. Nur die zwei Spieler:innen sehen
//   und ändern sie. Ein neuer Zug darf nur angehängt werden, wenn man selbst
//   am Zug ist; beendete Partien sind unveränderlich.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /players/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'stark.liam2011@gmail.com');
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /gifts/{giftId} {
      allow create: if request.auth != null && request.auth.token.email == 'stark.liam2011@gmail.com';
      allow read: if request.auth != null && (resource.data.toUid == request.auth.uid || request.auth.token.email == 'stark.liam2011@gmail.com');
      allow delete: if request.auth != null && resource.data.toUid == request.auth.uid;
    }
    match /chessProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /chessFriends/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requestedBy
        && request.resource.data.members == resource.data.members
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.status == 'accepted';
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }
    match /chessGames/{gameId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.players;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.players.size() == 2
        && request.auth.uid in request.resource.data.players
        && request.resource.data.status == 'invited'
        && request.resource.data.moves.size() == 0;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.players
        && resource.data.status != 'finished'
        && request.resource.data.players == resource.data.players
        && request.resource.data.white == resource.data.white
        && request.resource.data.black == resource.data.black
        && request.resource.data.createdBy == resource.data.createdBy
        && !(resource.data.status == 'invited' && request.resource.data.status == 'active'
             && request.auth.uid == resource.data.createdBy)
        && (request.resource.data.moves == resource.data.moves
            || (resource.data.status == 'active'
                && request.resource.data.moves.size() == resource.data.moves.size() + 1
                && ((resource.data.moves.size() % 2 == 0 && request.auth.uid == resource.data.white)
                    || (resource.data.moves.size() % 2 == 1 && request.auth.uid == resource.data.black))));
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.players
        && resource.data.status == 'invited';
    }
  }
}
