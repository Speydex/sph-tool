// ============================================================
// Firestore-Security-Rules für den BörsenTycoon Cloud-Speicherstand
// ============================================================
// Diese Datei wird NICHT automatisch deployt (dieses Projekt hat keine
// Firebase-CLI-Anbindung) — kopiere ihren Inhalt manuell in die Firebase-
// Konsole: Firestore Database -> Regeln -> einfügen -> Veröffentlichen.
//
// Wirkung: Jede*r eingeloggte Nutzer*in darf ausschließlich das eigene
// Speicherstand-Dokument (Dokument-ID = eigene Firebase-UID) lesen und
// schreiben. Niemand kann fremde Spielstände sehen oder verändern, auch
// nicht über die Konsole/API — nur eingeloggt und nur das eigene Dokument.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
