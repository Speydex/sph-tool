// ============================================================
// Firestore-Security-Rules für den BörsenTycoon Cloud-Speicherstand
// ============================================================
// Diese Datei wird NICHT automatisch deployt (dieses Projekt hat keine
// Firebase-CLI-Anbindung) — kopiere ihren Inhalt manuell in die Firebase-
// Konsole: Firestore Database -> Regeln -> einfügen (ersetzt den
// vorhandenen Text) -> Veröffentlichen.
//
// Wirkung:
// - saves/{userId}: Jede*r eingeloggte Nutzer*in darf ausschließlich das
//   eigene Speicherstand-Dokument lesen und schreiben. Niemand kann fremde
//   Spielstände sehen oder verändern, auch nicht über die Konsole/API.
// - leaderboard/{userId}: Öffentlich lesbar (auch ohne Login, damit die
//   Bestenliste im Spiel für alle sichtbar ist), aber jede*r darf
//   ausschließlich den eigenen Eintrag schreiben — niemand kann sich für
//   jemand anderen ausgeben oder fremde Platzierungen verändern.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
