// ============================================================
// Firestore-Security-Rules für den BörsenTycoon Cloud-Speicherstand
// ============================================================
// Diese Datei wird NICHT automatisch deployt (dieses Projekt hat keine
// Firebase-CLI-Anbindung) — kopiere ihren Inhalt manuell in die Firebase-
// Konsole: Firestore Database -> Regeln -> einfügen (ersetzt den
// vorhandenen Text) -> Veröffentlichen.
//
// Wirkung:
// - saves/{userId}: Jede*r eingeloggte Nutzer*in darf ausschließlich das
//   eigene Speicherstand-Dokument lesen und schreiben. Niemand kann fremde
//   Spielstände sehen oder verändern, auch nicht über die Konsole/API.
// - leaderboard/{userId}: Öffentlich lesbar (auch ohne Login, damit die
//   Bestenliste im Spiel für alle sichtbar ist), aber jede*r darf
//   ausschließlich den eigenen Eintrag schreiben — niemand kann sich für
//   jemand anderen ausgeben oder fremde Platzierungen verändern.
// - players/{userId}: Eine kleine Registrierung "wer hat sich schon mal
//   eingeloggt" (E-Mail + letzter Login), damit der Admin im Spiel eine
//   Person zum Geld-Verschicken auswählen kann. Nur der Account selbst
//   und die fest hinterlegte Admin-E-Mail dürfen das lesen — die E-Mails
//   bleiben vor den anderen Mitspieler:innen privat.
// - gifts/{giftId}: Geld-Geschenke vom Admin an eine bestimmte Person
//   (per UID adressiert). Nur die Admin-E-Mail darf neue Geschenke
//   anlegen; die beschenkte Person darf ihr eigenes Geschenk lesen und
//   nach Erhalt löschen (damit es nicht doppelt gutgeschrieben wird).
//   Ersetze die E-Mail-Adresse unten an allen drei Stellen, falls sich
//   dein Admin-Account mal ändert.
//
// Schach (web/schach/, Online-Modus):
// - chessProfiles/{userId}: Spielername + Freundescode. Für alle
//   eingeloggten Nutzer:innen lesbar (damit man Freunde per Code findet),
//   schreiben darf nur der Account selbst.
// - chessFriends/{a_b}: Freundschaft zwischen zwei Accounts. Nur die beiden
//   Beteiligten können sie sehen. Anlegen darf man nur eine eigene Anfrage,
//   annehmen darf nur die angefragte Person, entfernen dürfen beide.
// - chessGames/{gameId}: Online-Partien. Nur die zwei Spieler:innen sehen
//   und ändern sie. Ein neuer Zug darf nur angehängt werden, wenn man selbst
//   am Zug ist; beendete Partien sind unveränderlich.
//
// Clips (web/clips/, Videos nur für Freunde):
// - clipsMembers/{userId}: Wer in der Gruppe ist (Anzeigename, Profilbild,
//   wem man folgt). Nur
//   Mitglieder sehen die Liste. Beitreten kann jede*r mit Konto, außer wer
//   gesperrt ist. Entfernen darf man sich selbst oder der Admin.
// - clipsBanned/{userId}: Vom Admin entfernte Personen. Sie können nicht
//   wieder beitreten. Nur der Admin legt Sperren an und hebt sie auf.
// - clipsSeen/{userId}: Welche Videos man schon gesehen hat (für die
//   Reihenfolge im Feed). Nur man selbst kann das lesen und schreiben.
// - clipsReports/{videoId_userId}: Meldungen. Jede*r kann ein Video einmal
//   melden; dabei steigt der Zähler reports am Video um genau 1 (dann ist es
//   ausgeblendet). Nur der Admin sieht die Meldungen, löscht sie und setzt
//   den Zähler beim Freigeben auf 0.
// - clipsNames/{name}: Jeder Name (klein geschrieben) gehört genau einer
//   Person, damit kein Name doppelt vorkommt. Man kann nur einen Namen
//   belegen, den man gleichzeitig im eigenen Profil einträgt.
// - clipsVideos/{videoId}: Videos samt Unterdokumenten (chunks = das Video in
//   Stücken unter 1 MB, likes, comments) oder eingebettete TikTok-/YouTube-
//   Links (ohne Stücke). Nur Mitglieder sehen sie. Posten
//   und Löschen darf nur der Besitzer (Löschen auch der Admin). Der
//   Like-Zähler darf sich nur zusammen mit dem eigenen Like um genau 1 ändern.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /players/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'stark.liam2011@gmail.com');
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /gifts/{giftId} {
      allow create: if request.auth != null && request.auth.token.email == 'stark.liam2011@gmail.com';
      allow read: if request.auth != null && (resource.data.toUid == request.auth.uid || request.auth.token.email == 'stark.liam2011@gmail.com');
      allow delete: if request.auth != null && resource.data.toUid == request.auth.uid;
    }
    match /chessProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /chessFriends/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requestedBy
        && request.resource.data.members == resource.data.members
        && request.resource.data.requestedBy == resource.data.requestedBy
        && request.resource.data.status == 'accepted';
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }
    match /chessGames/{gameId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.players;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.players.size() == 2
        && request.auth.uid in request.resource.data.players
        && request.resource.data.status == 'invited'
        && request.resource.data.moves.size() == 0;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.players
        && resource.data.status != 'finished'
        && request.resource.data.players == resource.data.players
        && request.resource.data.white == resource.data.white
        && request.resource.data.black == resource.data.black
        && request.resource.data.createdBy == resource.data.createdBy
        && !(resource.data.status == 'invited' && request.resource.data.status == 'active'
             && request.auth.uid == resource.data.createdBy)
        && (request.resource.data.moves == resource.data.moves
            || (resource.data.status == 'active'
                && request.resource.data.moves.size() == resource.data.moves.size() + 1
                && ((resource.data.moves.size() % 2 == 0 && request.auth.uid == resource.data.white)
                    || (resource.data.moves.size() % 2 == 1 && request.auth.uid == resource.data.black))));
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.players
        && resource.data.status == 'invited';
    }

    // ---------- Clips ----------
    function clipsAdmin() {
      return request.auth != null && request.auth.token.email == 'stark.liam2011@gmail.com';
    }
    function clipsMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/clipsMembers/$(request.auth.uid));
    }
    function clipsName(n) {
      return n is string && n.size() >= 2 && n.size() <= 20
        && !n.matches('.*/.*') && !n.matches('[.]+') && !n.matches('__.*__');
    }
    // Der Name im Profil muss in clipsNames auf einen selbst eingetragen sein
    function clipsNameClaimed(userId) {
      return request.resource.data.nameKey == request.resource.data.name.lower()
        && getAfter(/databases/$(database)/documents/clipsNames/$(request.resource.data.nameKey)).data.uid == userId;
    }
    function clipsPhoto(p) {
      return p == null
        || (p is string && p.size() <= 80000 && p.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'));
    }
    match /clipsSeen/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['ids'])
        && request.resource.data.ids is map;
    }
    match /clipsReports/{reportId} {
      allow read, delete: if clipsAdmin();
      allow create: if clipsMember()
        && request.resource.data.keys().hasOnly(['videoId', 'owner', 'reporter', 'reason', 'at'])
        && request.resource.data.reporter == request.auth.uid
        && reportId == request.resource.data.videoId + '_' + request.auth.uid
        && request.resource.data.reason in ['nsfw', 'violence', 'bullying', 'other']
        && getAfter(/databases/$(database)/documents/clipsVideos/$(request.resource.data.videoId)).data.get('reports', 0)
           == get(/databases/$(database)/documents/clipsVideos/$(request.resource.data.videoId)).data.get('reports', 0) + 1;
    }
    match /clipsBanned/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || clipsAdmin());
      allow create: if clipsAdmin() && request.resource.data.keys().hasOnly(['name', 'at']);
      allow delete: if clipsAdmin();
    }
    match /clipsMembers/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || clipsMember());
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'nameKey', 'joinedAt'])
        && clipsName(request.resource.data.name)
        && clipsNameClaimed(userId)
        && !exists(/databases/$(database)/documents/clipsBanned/$(userId));
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameKey', 'photo', 'following'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name', 'nameKey'])
            || (clipsName(request.resource.data.name) && clipsNameClaimed(userId)))
        && clipsPhoto(request.resource.data.get('photo', null))
        && request.resource.data.get('following', []) is list
        && request.resource.data.get('following', []).size() <= 500;
      allow delete: if request.auth != null && (request.auth.uid == userId || clipsAdmin());
    }
    match /clipsNames/{key} {
      function member() {
        return /databases/$(database)/documents/clipsMembers/$(request.auth.uid);
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(member()).data.get('nameKey', '') == key;
      allow delete: if request.auth != null && (clipsAdmin()
        || (resource.data.uid == request.auth.uid
            && (!existsAfter(member()) || getAfter(member()).data.get('nameKey', '') != key)));
    }
    match /clipsVideos/{videoId} {
      function video() {
        return get(/databases/$(database)/documents/clipsVideos/$(videoId)).data;
      }
      function videoAfter() {
        return getAfter(/databases/$(database)/documents/clipsVideos/$(videoId)).data;
      }
      function myLike() {
        return /databases/$(database)/documents/clipsVideos/$(videoId)/likes/$(request.auth.uid);
      }
      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function myReport() {
        return /databases/$(database)/documents/clipsReports/$(videoId + '_' + request.auth.uid);
      }
      allow read: if clipsMember();
      // Entweder ein hochgeladenes Video (in Stücken) oder ein eingebetteter
      // TikTok-/YouTube-Link (ohne Stücke, sofort fertig)
      function uploadedVideo() {
        return request.resource.data.keys().hasOnly(['owner', 'caption', 'type', 'size', 'chunks', 'duration',
                                                     'thumb', 'likes', 'comments', 'ready', 'createdAt'])
          && request.resource.data.type is string && request.resource.data.type.size() <= 60
          && request.resource.data.size is int
          && request.resource.data.chunks is int
          && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 300
          && request.resource.data.duration is number
          && request.resource.data.ready == false;
      }
      function linkedVideo() {
        return request.resource.data.keys().hasOnly(['owner', 'caption', 'kind', 'provider', 'embedId', 'url',
                                                     'thumb', 'chunks', 'likes', 'comments', 'ready', 'createdAt'])
          && request.resource.data.kind == 'link'
          && request.resource.data.provider in ['tiktok', 'youtube']
          && request.resource.data.embedId is string
          && request.resource.data.embedId.matches('[A-Za-z0-9_-]{1,40}')
          && request.resource.data.url is string && request.resource.data.url.size() <= 500
          && request.resource.data.chunks == 0
          && request.resource.data.ready == true;
      }
      allow create: if clipsMember()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 300
        && (request.resource.data.thumb == null
            || (request.resource.data.thumb is string && request.resource.data.thumb.size() <= 60000))
        && request.resource.data.likes == 0
        && request.resource.data.comments == 0
        && request.resource.data.createdAt == request.time
        && (uploadedVideo() || linkedVideo());
      allow update: if clipsMember() && (
          (request.auth.uid == resource.data.owner
            && changed().hasOnly(['caption', 'ready'])
            && request.resource.data.caption is string
            && request.resource.data.caption.size() <= 300
            && request.resource.data.ready is bool)
          || (changed().hasOnly(['likes'])
            && ((request.resource.data.likes == resource.data.likes + 1
                 && !exists(myLike()) && existsAfter(myLike()))
                || (request.resource.data.likes == resource.data.likes - 1
                 && exists(myLike()) && !existsAfter(myLike()))))
          || (changed().hasOnly(['comments'])
            && request.resource.data.comments >= 0
            && (request.resource.data.comments == resource.data.comments + 1
                || request.resource.data.comments == resource.data.comments - 1))
          || (changed().hasOnly(['reports'])
            && request.resource.data.reports == resource.data.get('reports', 0) + 1
            && !exists(myReport()) && existsAfter(myReport()))
          || (clipsAdmin() && changed().hasOnly(['reports']) && request.resource.data.reports == 0));
      allow delete: if request.auth != null && (request.auth.uid == resource.data.owner || clipsAdmin());

      match /chunks/{chunkId} {
        allow read: if clipsMember();
        allow create: if request.auth != null
          && chunkId.matches('[0-9]{2,3}')
          && video().owner == request.auth.uid
          && video().ready == false
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 950000;
        allow delete: if request.auth != null && (video().owner == request.auth.uid || clipsAdmin());
      }
      match /likes/{userId} {
        allow read: if clipsMember();
        allow create: if clipsMember() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['at'])
          && videoAfter().likes == video().likes + 1;
        allow delete: if request.auth != null && (
          (request.auth.uid == userId && videoAfter().likes == video().likes - 1)
          || video().owner == request.auth.uid
          || clipsAdmin());
      }
      match /comments/{commentId} {
        allow read: if clipsMember();
        allow create: if clipsMember()
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 300
          && request.resource.data.createdAt == request.time
          && videoAfter().comments == video().comments + 1;
        allow delete: if request.auth != null && (
          resource.data.uid == request.auth.uid
          || video().owner == request.auth.uid
          || clipsAdmin());
      }
    }
  }
}
